<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LabProject.App</RootNamespace>
    <AssemblyName>LabProject</AssemblyName>
    <!-- Для честных замеров: сразу полностью оптимизированный код (без ступенчатой JIT-компиляции)
         и без фонового GC, который вносил бы шум во время. -->
    <TieredCompilation>false</TieredCompilation>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LabProject.Core\LabProject.Core.csproj" />
  </ItemGroup>

</Project>
